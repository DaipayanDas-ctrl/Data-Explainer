# Which LLM provider to use: "anthropic" or "groq"
LLM_PROVIDER=groq

# --- AWS Secrets Manager / Parameter Store (Optional, recommended for production) ---
# Set AWS_SECRET_NAME to automatically retrieve secrets at runtime from AWS Secrets Manager
# AWS_SECRET_NAME=my-app-secrets
# AWS_REGION=us-east-1

# --- Anthropic (used if LLM_PROVIDER=anthropic) ---
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Check https://docs.claude.com for current model strings if this one 404s for you.
CLAUDE_MODEL=claude-sonnet-5

# --- Groq (used if LLM_PROVIDER=groq) ---
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of exact origins allowed to call this API.
# In production, set this to your exact frontend domain (e.g., https://yourapp.com). Do NOT use wildcard '*'.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
ALLOWED_HEADERS=Content-Type,Authorization,Accept

# --- Rate Limiting & Client Auth ---
# Per-IP rate limit for LLM endpoints (e.g. "15/minute", "100/hour")
RATE_LIMIT_PER_MINUTE=15/minute

# Require client authentication for /api/claude endpoints (true/false)
REQUIRE_CLIENT_AUTH=false
# Optional client secret key for X-API-Key header or Bearer token auth
# CLIENT_API_KEY=your-client-access-key
# Optional JWT Secret for validating Bearer tokens
# JWT_SECRET=your-jwt-signing-secret

# --- Persistent Audit Log (CloudWatch / DynamoDB) ---
# Set AUDIT_LOG_TABLE_NAME to persist audit logs in Amazon DynamoDB across container restarts/deployments
# AUDIT_LOG_TABLE_NAME=data-explainer-audit-log
